# Скопіюйте в .env та задайте власні паролі.
DATABASE_URL=postgresql://recipe:change-me-locally@localhost:5432/recipes
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
SESSION_DAYS=7
# Необов'язково: абсолютний шлях до фотографій; типово recipe-app/uploads.
# UPLOADS_DIR=D:/recipe-uploads
POSTGRES_DB=recipes
POSTGRES_USER=recipe
POSTGRES_PASSWORD=change-me-locally
# Потрібні тільки для python -m scripts.seed. Мінімум 12 символів.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
