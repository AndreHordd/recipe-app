@startuml
title C4 Level 3: компоненти Backend API
left to right direction
skinparam monochrome true
skinparam shadowing false

rectangle "Web Application\n[HTML / CSS / JavaScript]" as web <<Container>>
package "Backend API [Python / FastAPI]" {
  component "API Facade\nFastAPI-роутери\nта залежності" as facade
  component "AuthenticationService\nОблікові записи та сесії" as auth
  component "RecipeService\nВласні рецепти та стани" as recipes
  component "RecipeSearchService\nСтратегії пошуку" as search
  component "CollectionService\nВласні колекції" as collections
  component "ModerationService\nМодерація та довідники" as moderation
  component "CatalogService\nЧитання довідників,\nстворення інгредієнта" as catalog
  component "Data Access\n[Python / psycopg]\n\nРепозиторії та SQL" as data
}
database "Database\n[PostgreSQL]" as db <<Container>>

web --> facade : JSON API
facade --> auth
facade --> recipes
facade --> search
facade --> collections
facade --> moderation
facade --> catalog
auth --> data : Через контракти
recipes --> data : Через контракти
search --> data : Читання через Strategy
collections --> data : Через контракти
moderation --> data : Через контракти
catalog --> data : Через контракт
data --> db : SQL
@enduml
